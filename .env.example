# Project Settings -> API -> clave publica (publishable / anon).
# No uses aqui la clave service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
